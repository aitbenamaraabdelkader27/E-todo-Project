# Local development: docker compose up -d db
DATABASE_URL="postgresql://flow:flow_local_password@localhost:5432/flow?schema=public"
# Integration tests must use a separate database with '_test' in its name.
TEST_DATABASE_URL="postgresql://flow:flow_local_password@localhost:5432/flow_test?schema=public"
APP_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
PORT=3001
POSTGRES_PORT=5432
# NODE_ENV is chosen by Vite and the start command. Do not force development builds here.
# Production cookies are Secure by default. COOKIE_SECURE=false is for local HTTP Docker only.
# COOKIE_SECURE=false
